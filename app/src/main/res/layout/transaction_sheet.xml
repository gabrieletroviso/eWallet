<?xml version="1.0" encoding="utf-8"?>
<!-- Dettaglio di un movimento (pannello dal basso): categoria, importo, data, descrizione, Modifica/Elimina -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Maniglia -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_meter_track" />

    <!-- Categoria + importo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/sheetIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_tile"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_cat_necessaria" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:fontFamily="@font/nunito_extrabold"
                android:id="@+id/sheetCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ew_text"
                android:textSize="17sp" />

            <TextView
                android:fontFamily="@font/nunito_semibold"
                android:id="@+id/sheetDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ew_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:fontFamily="@font/nunito_extrabold"
            android:id="@+id/sheetAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ew_text"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Descrizione -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Descrizione"
        android:textColor="@color/ew_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sheetDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_icon_tile"
        android:backgroundTint="@color/ew_background"
        android:padding="14dp"
        android:textColor="@color/ew_text"
        android:textSize="15sp" />

    <!-- Elimina / Modifica -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:fontFamily="@font/nunito_extrabold"
            android:id="@+id/deleteBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Elimina"
            android:textAllCaps="false"
            android:textColor="@color/ew_expense"
            android:textSize="15sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/delete"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/ew_expense"
            app:rippleColor="@color/ew_expense_container"
            app:strokeColor="@color/ew_expense"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:fontFamily="@font/nunito_extrabold"
            android:id="@+id/editBtn"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Modifica"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@color/ew_primary"
            app:cornerRadius="16dp"
            app:icon="@drawable/edit"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/white" />
    </LinearLayout>

</LinearLayout>
