<?xml version="1.0" encoding="utf-8"?>
<!-- Una riga della lista Movimenti: icona della categoria, categoria (+ descrizione), importo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_tile"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_cat_necessaria"
        app:tint="@color/ew_cat_necessaria_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:fontFamily="@font/nunito_extrabold"
            android:id="@+id/rowCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Necessaria"
            android:textColor="@color/ew_text"
            android:textSize="15sp" />

        <TextView
            android:fontFamily="@font/nunito_semibold"
            android:id="@+id/rowDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ew_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:fontFamily="@font/nunito_extrabold"
        android:id="@+id/rowAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:text="0,00 €"
        android:textColor="@color/ew_text"
        android:textSize="15sp" />

</LinearLayout>
