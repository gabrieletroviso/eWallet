<?xml version="1.0" encoding="utf-8"?>
<!-- Riga della legenda: colore, categoria, barra della percentuale, percentuale -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <View
        android:id="@+id/legendDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_legend_dot" />

    <TextView
        android:id="@+id/legendName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:textColor="@color/ew_text"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_meter_track"
        android:orientation="horizontal"
        android:weightSum="100">

        <View
            android:id="@+id/legendMeter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="@drawable/bg_meter_fill" />
    </LinearLayout>

    <TextView
        android:id="@+id/legendPercent"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:textColor="@color/ew_text"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
