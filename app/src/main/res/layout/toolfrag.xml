<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeAct"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="205dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/saveDbBtn"
            android:layout_width="130dp"
            android:layout_height="40dp"
            android:layout_marginStart="140dp"
            android:layout_marginEnd="141dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="@color/buttondefault"
            android:fontFamily="@font/nunito"
            android:text="SALVA"
            android:textColor="@color/apptext"
            app:layout_constraintBottom_toTopOf="@+id/clearBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/clearBtn"
            android:layout_width="130dp"
            android:layout_height="40dp"
            android:layout_marginStart="140dp"
            android:layout_marginEnd="141dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/buttondefault"
            android:fontFamily="@font/nunito"
            android:text="PULISCI"
            android:textColor="@color/apptext"
            app:layout_constraintBottom_toTopOf="@+id/restDbBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/restDbBtn"
            android:layout_width="130dp"
            android:layout_height="40dp"
            android:layout_marginStart="140dp"
            android:layout_marginEnd="141dp"
            android:backgroundTint="@color/buttondefault"
            android:fontFamily="@font/nunito"
            android:text="RIPRISTINA"
            android:textColor="@color/apptext"
            app:layout_constraintBottom_toTopOf="@+id/restData"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/restData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="184dp"
            android:layout_marginEnd="184dp"
            android:fontFamily="@font/nunito"
            android:text="TextView"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout_editor_absoluteY="382dp" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="119dp"
            android:layout_marginEnd="121dp"
            android:layout_marginBottom="41dp"
            android:fontFamily="@font/nunito"
            android:text="Gestione database"
            android:textColor="@color/apptext"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@+id/saveDbBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="186dp"
            android:layout_marginTop="105dp"
            android:layout_marginEnd="187dp"
            android:layout_marginBottom="15dp"
            app:layout_constraintBottom_toTopOf="@+id/textView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/googledrive" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>