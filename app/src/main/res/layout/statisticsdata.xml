<?xml version="1.0" encoding="utf-8"?>
<!-- Statistiche · Medie: medie mensili dell'anno e ripartizione media delle spese -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/statsDataConst"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:text="Medie mensili globali"
            android:textColor="@color/ew_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/incMeanLbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entrate"
                android:textColor="@color/ew_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incMeanVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/ew_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/expMeanLbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spese"
                android:textColor="@color/ew_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/expMeanVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/ew_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/balMeanCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:backgroundTint="@color/ew_income_container"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/balMeanLbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bilancio"
                android:textColor="@color/ew_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/balMeanVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/ew_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/projCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:backgroundTint="@color/ew_primary"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/projLbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proiezione annua"
                android:textColor="@color/ew_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/projVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/ew_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="Spese medie mensili"
            android:textColor="@color/ew_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <!-- Barra a segmenti: una parte per categoria (creata da codice) -->
            <LinearLayout
                android:id="@+id/expShareBar"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_meter_track"
                android:orientation="horizontal" />

            <!-- Righe Necessarie / Superflue / Extra (create da codice) -->
            <LinearLayout
                android:id="@+id/expMeanRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
