<?xml version="1.0" encoding="utf-8"?>
<!-- Una notifica raccolta: fonte e ora, titolo, testo completo (selezionabile) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/border"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:fontFamily="@font/nunito_semibold"
        android:id="@+id/capSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ew_primary"
        android:textSize="12sp" />

    <TextView
        android:fontFamily="@font/nunito_extrabold"
        android:id="@+id/capTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ew_text"
        android:textIsSelectable="true"
        android:textSize="15sp" />

    <TextView
        android:fontFamily="@font/nunito_semibold"
        android:id="@+id/capBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ew_text_secondary"
        android:textIsSelectable="true"
        android:textSize="13sp" />
</LinearLayout>
