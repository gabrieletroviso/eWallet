<?xml version="1.0" encoding="utf-8"?>
<!-- Home · Riepilogo: bilancio del mese, entrate/uscite e pulsanti per aggiungere movimenti -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeAct"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <!-- Card principale: bilancio del mese -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_primary"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bilancio del mese"
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/balImg"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_trend_flat"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/balBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In pari"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/balValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFeatureSettings="tnum"
            android:letterSpacing="-0.02"
            android:text="0,00 €"
            android:textColor="@color/white"
            android:textSize="44sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Entrate / Uscite -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_tile_income"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_in"
                app:tint="@color/ew_income" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Entrate"
                android:textColor="@color/ew_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/incValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="0,00 €"
                android:textColor="@color/ew_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/border"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_tile_expense"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_out"
                app:tint="@color/ew_expense" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Uscite"
                android:textColor="@color/ew_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/expValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="0,00 €"
                android:textColor="@color/ew_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Aggiungi movimento -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:text="Aggiungi movimento"
        android:textColor="@color/ew_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addBtn"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Entrata"
            android:textAllCaps="false"
            android:textColor="@color/ew_on_income_container"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ew_income_container"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_plus"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/ew_on_income_container" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/expBtn"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Uscita"
            android:textAllCaps="false"
            android:textColor="@color/ew_on_expense_container"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ew_expense_container"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_minus"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="@color/ew_on_expense_container" />
    </LinearLayout>

</LinearLayout>
