<?xml version="1.0" encoding="utf-8"?>
<!-- Finestra Nuova/Modifica entrata o uscita: importo, data, categoria, descrizione -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Titolo con icona -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dialogIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_tile"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_in" />

            <TextView
                android:fontFamily="@font/nunito_extrabold"
                android:id="@+id/dialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Nuova entrata"
                android:textColor="@color/ew_text"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Importo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/amountLayout"
            style="@style/Widget.eWallet.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Importo"
            app:placeholderText="0,00"
            app:suffixText="€">

            <com.google.android.material.textfield.TextInputEditText
                android:fontFamily="@font/nunito_extrabold"
                android:id="@+id/amountValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/ew_text"
                android:textSize="22sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Data -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dateLayout"
            style="@style/Widget.eWallet.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Data"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom"
            app:endIconTint="@color/ew_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:fontFamily="@font/nunito_extrabold"
                android:id="@+id/dateValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:maxLines="1"
                android:textColor="@color/ew_text"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Categoria -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Categoria"
            android:textColor="@color/ew_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/categoryChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <!-- Descrizione -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/descLayout"
            style="@style/Widget.eWallet.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Descrizione (facoltativa)"
            app:counterEnabled="true"
            app:counterMaxLength="30">

            <!-- Il database accetta al massimo 30 caratteri (TTransaction.setDescription) -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/descValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="30"
                android:maxLines="3"
                android:textColor="@color/ew_text"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Annulla / Salva -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:fontFamily="@font/nunito_extrabold"
                android:id="@+id/cancelBtn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Annulla"
                android:textAllCaps="false"
                android:textColor="@color/ew_text"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                app:strokeColor="@color/ew_outline"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:fontFamily="@font/nunito_extrabold"
                android:id="@+id/saveBtn"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Salva"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:backgroundTint="@color/ew_income"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
