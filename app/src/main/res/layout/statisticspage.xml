<?xml version="1.0" encoding="utf-8"?>
<!-- Statistiche: intestazione dell'anno e schede Andamento / Spese / Entrate / Medie -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ew_background">

    <!-- Intestazione: ‹  Statistiche / anno  › -->
    <include
        android:id="@+id/yearHeader"
        layout="@layout/period_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Schede -->
    <LinearLayout
        android:id="@+id/statsTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_tab_track"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/yearHeader">

        <TextView
            android:id="@+id/tabTrend"
            style="@style/Widget.eWallet.PillTab"
            android:text="Trend" />

        <Space
            android:layout_width="4dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tabExpenses"
            style="@style/Widget.eWallet.PillTab"
            android:text="Spese" />

        <Space
            android:layout_width="4dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tabIncome"
            style="@style/Widget.eWallet.PillTab"
            android:text="Entrate" />

        <Space
            android:layout_width="4dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tabAverages"
            style="@style/Widget.eWallet.PillTab"
            android:text="Medie" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/statisticsViewPage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statsTabs" />

    <include
        android:id="@+id/bottomNavBar"
        layout="@layout/bottomnav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
