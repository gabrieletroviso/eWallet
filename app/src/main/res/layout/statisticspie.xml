<?xml version="1.0" encoding="utf-8"?>
<!-- Statistiche · Spese / Entrate: grafico ad anello con la categoria selezionata al centro e legenda a barre -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Anello ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:fontFamily="@font/nunito_extrabold"
                android:id="@+id/pieHead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ripartizione spese"
                android:textColor="@color/ew_text"
                android:textSize="16sp" />

            <TextView
                android:fontFamily="@font/nunito_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Percentuale sul totale dell'anno"
                android:textColor="@color/ew_text_secondary"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp">

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/centerLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ew_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:fontFamily="@font/nunito_extrabold"
                        android:id="@+id/centerValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:letterSpacing="-0.01"
                        android:textColor="@color/ew_text"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/centerPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ===== Legenda ===== -->
        <LinearLayout
            android:id="@+id/legendRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/border"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <TextView
            android:fontFamily="@font/nunito_semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Tocca una categoria per vederne l'importo"
            android:textColor="@color/ew_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
