<?xml version="1.0" encoding="utf-8"?>
<!-- Intestazione con periodo: ‹  etichetta piccola / titolo grande  ›
     Usata dalla Home (anno / mese) e dalle Statistiche ("Statistiche" / anno). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <ImageButton
        android:id="@+id/periodPrevBtn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_surface"
        android:contentDescription="Precedente"
        android:elevation="1dp"
        android:src="@drawable/ic_chevron_left"
        app:tint="@color/ew_text" />

    <LinearLayout
        android:id="@+id/periodTitleBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/periodLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:textColor="@color/ew_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:fontFamily="@font/nunito_extrabold"
            android:id="@+id/periodTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ew_text"
            android:textSize="24sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/periodNextBtn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_surface"
        android:contentDescription="Successivo"
        android:elevation="1dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/ew_text" />

</LinearLayout>
