<?xml version="1.0" encoding="utf-8"?>
<!-- Primo piano dell'icona: portafoglio al centro, con i blu dell'app,
     e moneta con l'euro nei verdi delle entrate, sull'angolo in basso a destra.
     Tutto il disegno resta dentro la zona sicura dell'icona adattiva (cerchio di 66dp al centro). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Aletta posteriore: ew_primary_container con bordo ew_primary_dark -->
    <path
        android:fillColor="#FFE1ECFA"
        android:pathData="M41,34h24a4,4 0,0 1,4 4v6h-32v-6a4,4 0,0 1,4 -4z"
        android:strokeWidth="2"
        android:strokeColor="#FF174A94" />

    <!-- Corpo del portafoglio: da ew_primary a ew_primary_dark -->
    <path android:pathData="M40,40h28a6,6 0,0 1,6 6v20a6,6 0,0 1,-6 6h-28a6,6 0,0 1,-6 -6v-20a6,6 0,0 1,6 -6z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="40"
                android:endX="54"
                android:endY="72">
                <item android:offset="0" android:color="#FF1F5FBF" />
                <item android:offset="1" android:color="#FF174A94" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Linguetta di chiusura con il bottone -->
    <path
        android:fillColor="#FFE1ECFA"
        android:pathData="M66,50h8a4,4 0,0 1,4 4v4a4,4 0,0 1,-4 4h-8a4,4 0,0 1,-4 -4v-4a4,4 0,0 1,4 -4z" />
    <path
        android:fillColor="#FF1F5FBF"
        android:pathData="M66,56a2,2 0,1 0,4 0a2,2 0,1 0,-4 0z" />

    <!-- Ombra morbida della moneta -->
    <path
        android:fillColor="#26174A94"
        android:pathData="M59.8,70.2a11,11 0,1 0,22 0a11,11 0,1 0,-22 0z" />

    <!-- Moneta: bordo bianco e faccia nei verdi delle entrate (ew_income_container) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M59,69a11,11 0,1 0,22 0a11,11 0,1 0,-22 0z" />
    <path android:pathData="M61,69a9,9 0,1 0,18 0a9,9 0,1 0,-18 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="62"
                android:startY="61"
                android:endX="78"
                android:endY="77">
                <item android:offset="0" android:color="#FFDDF3E7" />
                <item android:offset="1" android:color="#FFBFE6D0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Simbolo dell'euro: ew_income -->
    <path
        android:pathData="M74.54,65.46A5,5 0,1 0,74.54 72.54"
        android:strokeWidth="2"
        android:strokeColor="#FF127A4B"
        android:strokeLineCap="round" />
    <path
        android:pathData="M65.4,67.8h6.4M65.4,70.2h6.4"
        android:strokeWidth="1.7"
        android:strokeColor="#FF127A4B"
        android:strokeLineCap="round" />
</vector>
